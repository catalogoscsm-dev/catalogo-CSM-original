# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
database/*.db-shm
database/*.db-wal

# private image map — regenerated by export-data.js before every build
data/image-map.json

# scripts temporários e artefatos de teste (nunca versionados)
scripts/_tmp/
scripts/_exportar-privado.cjs
scripts/*.pdf
scripts/*.bin
check-db.js
amanha.md

# imagens originais com nomes de fornecedor (ficam localmente, não no repo)
public/imagens/

# imagens hash — 1.7 GB; use Git LFS antes de commitar: git lfs track "public/img/*"
public/img/

.vercel
.env*

# ...mas o template de exemplo deve ser versionado (sem segredos)
!.env.example
